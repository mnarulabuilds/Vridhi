generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum AccountType {
  CASH
  SAVINGS
  CURRENT
  CREDIT_CARD
  WALLET
  INVESTMENT
  LOAN
  OTHER_ASSET
}

enum TransactionType {
  INCOME
  EXPENSE
  TRANSFER
}

enum AiMessageRole {
  USER
  ASSISTANT
}

enum SubscriptionPlan {
  FREE
  PRO
}

enum SubscriptionStatus {
  ACTIVE
  CANCELED
  PAST_DUE
  TRIALING
}

enum ConnectionStatus {
  PENDING
  LINKED
  SYNCING
  ERROR
  DISCONNECTED
}

enum AssetClass {
  EQUITY
  MUTUAL_FUND
  ETF
  DEBT
  CRYPTO
  REAL_ESTATE
  OTHER
}

enum GoalStatus {
  ACTIVE
  COMPLETED
  PAUSED
}

enum ReportKind {
  MONTHLY_GROWTH
  NET_WORTH
  PORTFOLIO
  TAX_SUMMARY
}

model User {
  id                    String    @id @default(cuid())
  name                  String
  email                 String    @unique
  passwordHash          String
  preferredCurrency     String    @default("INR")
  timezone              String    @default("Asia/Kolkata")
  locale                String    @default("en-IN")
  onboardingCompletedAt DateTime?

  accounts            Account[]
  categories          Category[]
  budgets             Budget[]
  refreshTokens       RefreshToken[]
  conversations       AiConversation[]
  passwordResets      PasswordResetToken[]
  subscription        UserSubscription?
  financialConnections FinancialConnection[]
  holdings            Holding[]
  goals               Goal[]
  reportRuns          ReportRun[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model Account {
  id             String      @id @default(cuid())
  name           String
  type           AccountType
  openingBalance Decimal     @db.Decimal(15, 2)
  currency       String      @default("INR")
  icon           String?
  color          String?
  isArchived     Boolean     @default(false)
  userId         String
  externalAccountId String?  @unique

  transactions        Transaction[]
  incomingTransfers   Transaction[] @relation("TransferDestination")
  externalAccount     ExternalAccount? @relation(fields: [externalAccountId], references: [id], onDelete: SetNull)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("accounts")
}

model Transaction {
  id                   String          @id @default(cuid())
  title                String
  amount               Decimal         @db.Decimal(15, 2)
  type                 TransactionType
  notes                String?
  merchant             String?
  transactionDate      DateTime
  accountId            String
  categoryId           String?
  transferToAccountId  String?
  importHash           String?
  externalId           String?

  account           Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  transferToAccount Account?  @relation("TransferDestination", fields: [transferToAccountId], references: [id], onDelete: SetNull)
  category          Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([accountId, importHash])
  @@index([accountId, transactionDate])
  @@index([categoryId])
  @@index([transferToAccountId])
  @@index([accountId, externalId])
  @@map("transactions")
}

model Category {
  id         String          @id @default(cuid())
  name       String
  type       TransactionType
  color      String?
  icon       String?
  isArchived Boolean         @default(false)
  userId     String

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  budgets      Budget[]
  transactions Transaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, name, type])
  @@index([userId])
  @@map("categories")
}

model Budget {
  id          String   @id @default(cuid())
  amount      Decimal  @db.Decimal(15, 2)
  periodStart DateTime
  periodEnd   DateTime
  userId      String
  categoryId  String

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, categoryId, periodStart])
  @@index([userId, periodStart])
  @@map("budgets")
}

model RefreshToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId])
  @@map("password_reset_tokens")
}

model AiConversation {
  id     String @id @default(cuid())
  title  String?
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  messages AiMessage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("ai_conversations")
}

model AiMessage {
  id             String        @id @default(cuid())
  role           AiMessageRole
  content        String
  conversationId String
  conversation   AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([conversationId])
  @@map("ai_messages")
}

model UserSubscription {
  id                   String             @id @default(cuid())
  userId               String             @unique
  plan                 SubscriptionPlan   @default(FREE)
  status               SubscriptionStatus @default(ACTIVE)
  provider             String?
  externalCustomerId   String?
  externalSubscriptionId String?
  currentPeriodEnd     DateTime?
  adsEnabled           Boolean            @default(true)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("user_subscriptions")
}

model FinancialConnection {
  id              String           @id @default(cuid())
  userId          String
  provider        String
  institutionName String?
  status          ConnectionStatus @default(PENDING)
  externalItemId  String?
  lastSyncedAt    DateTime?
  lastError       String?

  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  externalAccounts ExternalAccount[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([userId, provider])
  @@map("financial_connections")
}

model ExternalAccount {
  id           String   @id @default(cuid())
  connectionId String
  externalId   String
  name         String
  mask         String?
  type         AccountType @default(OTHER_ASSET)
  currency     String   @default("INR")

  connection FinancialConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  account    Account?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([connectionId, externalId])
  @@index([connectionId])
  @@map("external_accounts")
}

model Holding {
  id            String     @id @default(cuid())
  userId        String
  symbol        String
  name          String
  assetClass    AssetClass @default(OTHER)
  quantity      Decimal    @db.Decimal(18, 6)
  costBasis     Decimal    @db.Decimal(15, 2)
  currency      String     @default("INR")
  lastPrice     Decimal?   @db.Decimal(15, 4)
  lastPriceAt   DateTime?
  accountId     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([userId, symbol])
  @@map("holdings")
}

model Goal {
  id            String     @id @default(cuid())
  userId        String
  name          String
  targetAmount  Decimal    @db.Decimal(15, 2)
  currentAmount Decimal    @db.Decimal(15, 2) @default(0)
  targetDate    DateTime?
  status        GoalStatus @default(ACTIVE)
  currency      String     @default("INR")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, status])
  @@map("goals")
}

model ReportRun {
  id          String     @id @default(cuid())
  userId      String
  kind        ReportKind
  periodStart DateTime?
  periodEnd   DateTime?
  payload     Json

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId, kind, createdAt])
  @@map("report_runs")
}
