# Copy to .env.production and fill in real values. Never commit the filled file.
# docker compose --env-file .env.production -f docker-compose.yml -f docker-compose.prod.yml up -d --build

NODE_ENV=production
PORT=3001

POSTGRES_DB=vridhi
POSTGRES_USER=vridhi
POSTGRES_PASSWORD=change-me-to-a-long-random-password

# openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-secret
JWT_ACCESS_TOKEN_EXPIRY=15m
JWT_REFRESH_TOKEN_EXPIRY_DAYS=30

# Native app does not need CORS. Add Expo web origins here if you ship web.
CORS_ORIGINS=

AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=
