DATABASE_URL="postgresql://postgres:postgres@localhost:5432/vridhi?schema=public"
JWT_SECRET="replace-with-a-long-random-secret"
JWT_ACCESS_TOKEN_EXPIRY="15m"
JWT_REFRESH_TOKEN_EXPIRY_DAYS=30
PORT=3001
CORS_ORIGINS="http://localhost:8081,http://localhost:19006"

# Ask: structured questions (spend, budgets, recurring bills) never need a model.
# Open chat uses an OpenAI-compatible API. Leave the key empty to skip the LLM.
AI_PROVIDER="openai"
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
# OPENAI_BASE_URL="https://api.openai.com/v1"

# Local model instead of OpenAI. Use a small model (3B–8B). 20B+ freezes interactive Ask.
# AI_PROVIDER=ollama
# OPENAI_MODEL=llama3.2
# OPENAI_BASE_URL=http://host.docker.internal:11434/v1
