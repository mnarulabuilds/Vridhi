# Copy to .env.production and fill in real values. Never commit the filled file.
#   npm run deploy:init
#   npm run deploy              # backend → Render
#   npm run deploy:mobile       # Android APK against EXPO_PUBLIC_API_URL
#   npm run deploy:play         # Play Store AAB (internal draft)

NODE_ENV=production

# Render Web Service URL (hostname only, no https://)
API_DOMAIN=your-service.onrender.com
EXPO_PUBLIC_API_URL=https://your-service.onrender.com

# Optional. Dashboard → service → Settings. If empty, the CLI matches by
# RENDER_SERVICE_NAME, slug, or API_DOMAIN (e.g. vridhi-8hjg.onrender.com).
RENDER_SERVICE_ID=
RENDER_SERVICE_NAME=vridhi-api

# Play Console service account JSON for `npm run deploy:play`. Never commit this file.
# Play Console → Users and permissions → Invite new users → grant Release to testing tracks,
# then Google Cloud → service account key JSON.
PLAY_SERVICE_ACCOUNT_JSON=mobile/google-play-service-account.json

# Used for local Docker deploy: `npm run deploy -- --local` or `npm run deploy:live:local`.
POSTGRES_DB=vridhi
POSTGRES_USER=vridhi
POSTGRES_PASSWORD=change-me-to-a-long-random-password
JWT_SECRET=change-me-to-a-long-random-secret
JWT_ACCESS_TOKEN_EXPIRY=15m
JWT_REFRESH_TOKEN_EXPIRY_DAYS=30
PORT=3001
CORS_ORIGINS=

AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=
