# Copy to .env.production and fill in real values. Never commit the filled file.
#   npm run deploy:init
#   npm run deploy

NODE_ENV=production
PORT=3001

POSTGRES_DB=vridhi
POSTGRES_USER=vridhi
# Use hex (openssl rand -hex 32). Avoid `/` in the password — Compose puts it in DATABASE_URL.
POSTGRES_PASSWORD=change-me-to-a-long-random-password

# openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-secret
JWT_ACCESS_TOKEN_EXPIRY=15m
JWT_REFRESH_TOKEN_EXPIRY_DAYS=30

# Native app does not need CORS. Add Expo web origins here if you ship web.
CORS_ORIGINS=

# Public hostname only (no https://). When set, `npm run deploy:api` starts Caddy with TLS.
# Point a DNS A record at this machine first.
API_DOMAIN=vridhi-8hjg.onrender.com

# Baked into the Expo/EAS binary. Defaults to https://$API_DOMAIN when that is set.
EXPO_PUBLIC_API_URL=https://vridhi-8hjg.onrender.com

AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=

# Local Ollama on the Docker host (not 127.0.0.1 — that is the container loopback):
# AI_PROVIDER=ollama
# OPENAI_MODEL=llama3.2
# OPENAI_BASE_URL=http://host.docker.internal:11434/v1
