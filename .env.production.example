# Copy to .env.production and fill in real values. Never commit the filled file.
#   npm run deploy:init
#   npm run deploy              # backend → Render
#   npm run deploy:mobile       # Android APK against EXPO_PUBLIC_API_URL

NODE_ENV=production

# Render Web Service URL (hostname only, no https://)
API_DOMAIN=your-service.onrender.com
EXPO_PUBLIC_API_URL=https://your-service.onrender.com

# Optional. Dashboard → service → Settings. If empty, the CLI looks up vridhi-api
# or a service whose URL matches API_DOMAIN.
RENDER_SERVICE_ID=
RENDER_SERVICE_NAME=vridhi-api

# Used only for `npm run deploy:api:local` (Docker on this machine).
POSTGRES_DB=vridhi
POSTGRES_USER=vridhi
POSTGRES_PASSWORD=change-me-to-a-long-random-password
JWT_SECRET=change-me-to-a-long-random-secret
JWT_ACCESS_TOKEN_EXPIRY=15m
JWT_REFRESH_TOKEN_EXPIRY_DAYS=30
PORT=3001
CORS_ORIGINS=

AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=
